# Redmine 个人看板配置
# 复制本文件为 .env 并填入实际值，或直接用环境变量启动：
#   REDMINE_API_KEY=xxx node server.js

# Redmine 地址（末尾不要带斜杠）
REDMINE_URL=https://redmine.example.com/redmine

# 你的 Redmine API Key
# 获取方式：Redmine → 我的帐户 → 右侧「API 访问密钥」→ 显示/重置
REDMINE_API_KEY=在这里填入你的key

# 看板服务端口
PORT=7788

# ── GitLab MR 状态（可选）──
# 默认自动读取 glab CLI 配置里的 token（~/.config/glab-cli/config.yml
# 或 macOS 的 ~/Library/Application Support/glab-cli/config.yml），
# 已用 glab 登录过则无需配置。
# 需要覆盖时再取消注释：

# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-xxxx
